# Ключ JavaScript API Яндекс.Карт — основная карта сайта.
# Получить: https://developer.tech.yandex.ru → «Подключить API» → JavaScript API.
# ВНИМАНИЕ: это НЕ тот ключ, что в мобильном приложении. Там используется
# MapKit SDK — другой продукт, ключи не взаимозаменяемы.
# Пока переменная пустая, сайт показывает прежнюю карту на 2ГИС.
VITE_YANDEX_JS_KEY=

# Ключ 2ГИС MapGL — запасная карта, пока нет ключа Яндекса.
# Получить в Platform Manager: https://platform.2gis.ru/
# Для локальной разработки скопируйте этот файл в .env.local и впишите ключ.
VITE_2GIS_API_KEY=

# Адрес бэкенда (аккаунты, друзья, чаты).
# Локально можно не указывать — по умолчанию http://localhost:4000.
# На сайте впиши адрес развёрнутого сервера, например https://api.localee.ru
VITE_API_URL=
