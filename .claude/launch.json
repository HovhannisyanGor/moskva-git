{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "routeo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "routeo-local-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_API_URL=http://localhost:4123 npm run dev -- --port 5174"],
