# Скопируй этот файл в .env и при необходимости поменяй значения.
# Локально хватит значений по умолчанию. На хостинге поменяешь только этот файл — код трогать не нужно.

# Порт, на котором работает API
PORT=4000

# Секрет для подписи токенов (пропусков пользователей).
# На хостинге ОБЯЗАТЕЛЬНО замени на длинную случайную строку.
JWT_SECRET=dev-secret-change-me

# Путь к файлу базы данных (SQLite). База — это просто этот файл.
DB_PATH=./data/localee.db

# Каким сайтам разрешено обращаться к API.
# Локально: * (всем). На проде поставь адрес фронта, например https://localee.ru
CORS_ORIGIN=*

# Администраторы: email-адреса через запятую. Эти пользователи получают доступ
# к админ-панели (роль admin) автоматически — при старте сервера и при входе.
# Оставь пустым, если админы пока не нужны. Пример:
# ADMIN_EMAILS=me@example.com, boss@example.com
ADMIN_EMAILS=

# --- Файловое хранилище картинок и документов ---
# Куда складывать загруженные файлы. Папка рядом с базой, чтобы бэкап забирал
# и базу, и файлы одной командой.
UPLOAD_DIR=./data/uploads

# Адрес, по которому файлы видны снаружи. В базу пишется ПОЛНАЯ ссылка, поэтому
# на проде это ОБЯЗАТЕЛЬНО нужно задать — иначе ссылки уедут на localhost и
# картинки не откроются. Локально можно не указывать.
# PUBLIC_URL=https://api.localee.ru
